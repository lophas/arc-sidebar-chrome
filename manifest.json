{
  "manifest_version": 3,
  "name": "Arc Sidebar for Chrome",
  "version": "0.2.1",
  "description": "Arc-like Spaces, folders and persistent pinned tabs in Chrome's side panel.",
  "permissions": ["tabs", "storage", "sidePanel", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "Open Arc Sidebar"
  }
}
