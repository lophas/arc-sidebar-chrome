{
  "manifest_version": 3,
  "name": "Arc Side of the Chrome",
  "version": "3.0.1",
  "version_name": "3.0.1",
  "key": "",
  "description": "Spaces, tabs & a little harmony. Organize Chrome with a sidebar, Favorites, folders and automatic YouTube Picture-in-Picture.",
  "permissions": [
    "tabs",
    "scripting",
    "tabGroups",
    "storage",
    "sidePanel",
    "favicon",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/overlay/overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "src/media/auto-pip.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "src/media/auto-pip-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open Arc Side of the Chrome"
  },
  "commands": {
    "arc-command-bar-v3": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open Arc Side of the Chrome search"
    }
  },
  "short_name": "ASotC"
}
