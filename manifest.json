{
  "manifest_version": 3,
  "name": "Arc Sidebar for Chrome",
  "version": "0.6.0",
  "description": "Arc-like Spaces, folders and persistent pinned tabs in Chrome's side panel.",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/overlay/overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/sidepanel/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "Open Arc Sidebar"
  }
}
